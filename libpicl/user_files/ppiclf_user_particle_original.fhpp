! Y, YDot Components

! particle position
@:ADDPROP(pos, vec_real, solution, ghost)
! x velocity
@:ADDPROP(vel, vec_real, solution, ghost)
! angular velocity (?)
@:ADDPROP(ang_vel, vec_real, solution, ghost)


@:ADDPROP(t, real, solution, ghost)
@:ADDPROP(metal, real, solution, ghost)
@:ADDPROP(oxide, real, solution, ghost)



! rprop: PPICLF_LRP
! rho p
@:ADDPROP(RHOp, real, ghost, prop)

! rho f (rho fluid, interpolated ?)
@:ADDPROP(RHOf, real, ghost, prop)

! particle diameter(?)
@:ADDPROP(Dp, real, ghost, prop)

@:ADDPROP(VOLp, real, ghost, prop)
@:ADDPROP(PHIp, real, ghost, prop)

! gas velocity vector
@:ADDPROP(U, vec_real, prop, ghost)

@:ADDPROP(CS, real, ghost, prop)

! gas pressure derivative
@:ADDPROP(DPDX, vec_real, prop, ghost)

! Du/Dt (?) Gas substantial derivative
@:ADDPROP(SDR, vec_real, prop, ghost)

@:ADDPROP(RHSR, real, ghost, prop)

! gas density velocity vector
@:ADDPROP(PGC, vec_real, prop, ghost)

@:ADDPROP(JDPi, real, ghost, prop)
@:ADDPROP(JDPe, real, ghost, prop)
@:ADDPROP(JSPL, real, ghost, prop)
@:ADDPROP(JSPT, real, ghost, prop)

@:ADDPROP(JT, real, ghost, prop)

! fluctuating QS force vector
@:ADDPROP(FLUCTF, vec_real, prop)

! relative acceleration
@:ADDPROP(WDOT, vec_real, prop, ghost)

! gas-phase vorticity (interpolated)
@:ADDPROP(VOR, vec_real, prop, ghost)

! initial particle diameter ?
@:ADDPROP(IDp, real, ghost, prop)

! total burn time
@:ADDPROP(BRNT, real, ghost, prop)

! pressure (?) (interpolated from fluid?, prop)
@:ADDPROP(Pf, real, ghost, prop)

! grad of rho^g (fluid)
@:ADDPROP(RHOG, vec_real, prop, ghost)

! ?????? 
@:ADDPROP(DPVDX, vec_real, prop, ghost)

! DOmega/Dt (?)
@:ADDPROP(SDO, vec_real, prop, ghost)

@:ADDPROP(XIPAR, real, ghost, prop)
@:ADDPROP(XIPERP, real, ghost, prop)
@:ADDPROP(XIT, real, ghost, prop)


