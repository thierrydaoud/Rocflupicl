! Y, YDot Components

! x position
@:ADDPROP(x, real, solution, ghost)
! y position
@:ADDPROP(y, real, solution, ghost)
! z position
@:ADDPROP(z, real, solution, ghost)

! x velocity
@:ADDPROP(vx, real, solution, ghost)
! y velocity
@:ADDPROP(vy, real, solution, ghost)
! z velocity
@:ADDPROP(vz, real, solution, ghost)

@:ADDPROP(t, real, solution, ghost)

! angular velocity (?)
@:ADDPROP(ox, real, solution, ghost)
@:ADDPROP(oy, real, solution, ghost)
@:ADDPROP(oz, real, solution, ghost)

@:ADDPROP(metal, real, solution, ghost)
@:ADDPROP(oxide, real, solution, ghost)



! rprop: PPICLF_LRP
! rho p
@:ADDPROP(JRHOP, real, ghost)

! rho f (rho fluid, interpolated ?)
@:ADDPROP(JRHOF, real, ghost)

! particle diameter(?)
@:ADDPROP(JDP, real, ghost)

@:ADDPROP(JVOLP, real, ghost)
@:ADDPROP(JPHIP, real, ghost)
@:ADDPROP(JUX, real, ghost)
@:ADDPROP(JUY, real, ghost)
@:ADDPROP(JUZ, real, ghost)
@:ADDPROP(JCS, real, ghost)
@:ADDPROP(JDPDX, real, ghost)
@:ADDPROP(JDPDY, real, ghost)
@:ADDPROP(JDPDZ, real, ghost)

! Du/Dt (?)
@:ADDPROP(JSDRX, real, ghost)
@:ADDPROP(JSDRY, real, ghost)
@:ADDPROP(JSDRZ, real, ghost)

@:ADDPROP(JRHSR, real, ghost)
@:ADDPROP(JPGCX, real, ghost)
@:ADDPROP(JPGCY, real, ghost)
@:ADDPROP(JPGCZ, real, ghost)
@:ADDPROP(JDPi, real, ghost)
@:ADDPROP(JDPe, real, ghost)
@:ADDPROP(JSPL, real, ghost)
@:ADDPROP(JSPT, real, ghost)
@:ADDPROP(JT, real, ghost)
@:ADDPROP(FLUCTFX, real, ghost)
@:ADDPROP(FLUCTFY, real, ghost)
@:ADDPROP(FLUCTFZ, real, ghost)
@:ADDPROP(WDOTX, real, ghost)
@:ADDPROP(WDOTY, real, ghost)
@:ADDPROP(WDOTZ, real, ghost)

! gas-phase vorticity (interpolated)
@:ADDPROP(JXVOR, real, ghost)
@:ADDPROP(JYVOR, real, ghost)
@:ADDPROP(JZVOR, real, ghost)

! max particle diameter ?
@:ADDPROP(JIDP, real, ghost)

! total burn time
@:ADDPROP(JBRNT, real, ghost)

! pressure (?) (interpolated from fluid?)
@:ADDPROP(JP, real, ghost)

@:ADDPROP(JRHOGX, real, ghost)
@:ADDPROP(JRHOGY, real, ghost)
@:ADDPROP(JRHOGZ, real, ghost)
@:ADDPROP(JDPVDX, real, ghost)
@:ADDPROP(JDPVDY, real, ghost)
@:ADDPROP(JDPVDZ, real, ghost)

! DOmega/Dt (?)
@:ADDPROP(JSDOX, real, ghost)
@:ADDPROP(JSDOY, real, ghost)
@:ADDPROP(JSDOZ, real, ghost)

@:ADDPROP(XIPAR, real, ghost)
@:ADDPROP(XIPERP, real, ghost)
@:ADDPROP(XIT, real, ghost)


