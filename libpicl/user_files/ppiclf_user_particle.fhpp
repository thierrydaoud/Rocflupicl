! map: PPICLF_LRP_PRO
!--- Particle Volume Fraction Feedback
@:ADDPROP(P_JPHIP, proj)
!--- x,y,z Forces Feedback
! x feedback force
@:ADDPROP(JFX, proj)
! y feedback force
@:ADDPROP(JFY, proj)
! z feedback force
@:ADDPROP(JFZ, proj)
!---Energy Feedback
@:ADDPROP(JE, proj)
!--- More VF quanities. ***NEED TO CONFIRM THEY ARE USED ***
@:ADDPROP(JPHIPD, proj)
@:ADDPROP(JPHIPU, proj)
@:ADDPROP(JPHIPV, proj)
@:ADDPROP(JPHIPW, proj)
@:ADDPROP(JPHIPT, proj)
!--- Reynolds Subgrid Stress Tensor (RSG)
@:ADDPROP(JRSG11, proj)
@:ADDPROP(JRSG12, proj)
@:ADDPROP(JRSG13, proj)
@:ADDPROP(JRSG21, proj)
@:ADDPROP(JRSG22, proj)
@:ADDPROP(JRSG23, proj)
@:ADDPROP(JRSG31, proj)
@:ADDPROP(JRSG32, proj)
@:ADDPROP(JRSG33, proj)
!--- Pseudo Turbulent Kinetic Energy
@:ADDPROP(JTSG1, proj)
@:ADDPROP(JTSG2, proj)
@:ADDPROP(JTSG3, proj)



